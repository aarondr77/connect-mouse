title: PROJECT 3 — JOYSTICK + ULTRASONIC
window_title: Project 3
logo_path: null
timeline:
  show: false
  display: relative
  pixels_per_tick: 0.0
  milestones: []
streaming:
  buffer_size: 5000
  timeline: null
  playback_speed: null
  window: null
  persistence:
  - enabled: 'true'
    data_source_rid: null
    file_path: null
    streams: []
  channels:
  - channel: joystick_x.value
    unit: V
  - channel: joystick_y.value
    unit: V
  - channel: distance.value
    unit: cm
  - channel: mouse_control_on.value
  - channel: enable_out.value
  - channel: mouse_dx.value
    unit: px
  - channel: mouse_dy.value
    unit: px
  - channel: click.value
  - channel: near_state.value
python:
  packages:
  - nominal-instro[daq]
  - nominal
  - labjack-ljm
  - pynput
  wheelhouse: null
on_load: null
on_unload: null
tiles:
- layout: tabs
  tabs:
  - title: Home
    allow_popout: true
    tile:
      layout: grid
      rows:
      - height: null
        columns:
        - width: null
          tile:
            layout: pane
            id: f1a2b3c4-d5e6-4789-a012-300000000010
            title: Welcome
            direction: vertical
            should_fill: true
            elements:
            - display: markdown
              path: instructions.md
  - title: Live
    allow_popout: true
    tile:
      layout: grid
      rows:
      - height: 0.38
        columns:
        - width: 1.0
          tile:
            layout: pane
            id: f1a2b3c4-d5e6-4789-a012-300000000001
            title: Sensors — start / stop
            direction: vertical
            should_fill: true
            elements:
            - controls: script_table
              scripts:
              - id: mouse-control
                label: Project 3 — Mouse control
                path: /Users/aarondiamond-reivich/Nominal/projects/project3/mouse-control.py
                args: []
                max_log_lines: 10000
              show_output_column: true
        - width: 1.0
          tile:
            layout: pane
            id: f1a2b3c4-d5e6-4789-a012-300000000002
            title: Mouse control
            direction: vertical
            should_fill: true
            elements:
            - id: null
              spacing: normal
              inputs:
              - input: toggle_switch
                id: mouse_control_on
                label: Mouse control on
                on_toggle_action:
                - _kind: message
                  topic: script/project3/mouse_control_on
                  contents:
                    enabled: $mouse_control_on
              - input: slider
                id: mouse_speed
                label: Mouse speed (px/V)
                value: 80
                min: 10
                max: 300
              - input: slider
                id: dead_zone_v
                label: Dead zone (V)
                value: 0.25
                min: 0.05
                max: 0.8
              - input: checkbox
                id: invert_y
                label: Invert Y
                value: true
              - input: slider
                id: near_cm
                label: Near threshold (cm)
                value: 15
                min: 5
                max: 40
              - input: slider
                id: far_cm
                label: Far threshold (cm)
                value: 22
                min: 10
                max: 60
              - input: slider
                id: stable_ms
                label: Click stable (ms)
                value: 100
                min: 0
                max: 500
      - height: 0.32
        columns:
        - width: 1.0
          tile:
            layout: pane
            id: f1a2b3c4-d5e6-4789-a012-300000000004
            title: Joystick X (V)
            direction: vertical
            should_fill: true
            elements:
            - plot: line
              stream_id: joystick_x
              channels:
              - value
              colors: []
              legend_placement: bottom_left
              x_format: timestamp
              x_time_display: Local
              x_scale: linear
              y_scale: linear
        - width: 1.0
          tile:
            layout: pane
            id: f1a2b3c4-d5e6-4789-a012-300000000005
            title: Joystick Y (V)
            direction: vertical
            should_fill: true
            elements:
            - plot: line
              stream_id: joystick_y
              channels:
              - value
              colors: []
              legend_placement: bottom_left
              x_format: timestamp
              x_time_display: Local
              x_scale: linear
              y_scale: linear
      - height: 0.3
        columns:
        - width: 1.0
          tile:
            layout: pane
            id: f1a2b3c4-d5e6-4789-a012-300000000006
            title: Distance (cm)
            direction: vertical
            should_fill: true
            elements:
            - plot: line
              stream_id: distance
              channels:
              - value
              colors: []
              legend_placement: bottom_left
              x_format: timestamp
              x_time_display: Local
              x_scale: linear
              y_scale: linear
        - width: 1.0
          tile:
            layout: pane
            id: f1a2b3c4-d5e6-4789-a012-300000000007
            title: Mouse control on / enable
            direction: vertical
            should_fill: true
            elements:
            - plot: line
              stream_id: mouse_control_on
              channels:
              - value
              colors: []
              legend_placement: bottom_left
              x_format: timestamp
              x_time_display: Local
              x_scale: linear
              y_scale: linear
      - height: 0.25
        columns:
        - width: 1.0
          tile:
            layout: pane
            id: f1a2b3c4-d5e6-4789-a012-300000000008
            title: Click
            direction: vertical
            should_fill: true
            elements:
            - plot: line
              stream_id: click
              channels:
              - value
              colors: []
              legend_placement: bottom_left
              x_format: timestamp
              x_time_display: Local
              x_scale: linear
              y_scale: linear
        - width: 1.0
          tile:
            layout: pane
            id: f1a2b3c4-d5e6-4789-a012-300000000009
            title: Near state
            direction: vertical
            should_fill: true
            elements:
            - plot: line
              stream_id: near_state
              channels:
              - value
              colors: []
              legend_placement: bottom_left
              x_format: timestamp
              x_time_display: Local
              x_scale: linear
              y_scale: linear
  - title: Tests
    allow_popout: true
    tile:
      layout: grid
      rows:
      - height: null
        columns:
        - width: null
          tile:
            layout: pane
            id: f1a2b3c4-d5e6-4789-a012-300000000003
            title: Test Workflow
            direction: vertical
            should_fill: true
            elements:
            - display: markdown
              path: test_instructions.md
            - controls: test_workflow
              label: null
              script:
                id: mouse-tests
                label: Mouse Tests
                path: /Users/aarondiamond-reivich/Nominal/projects/project3/mouse_tests.py
                args: []
                max_log_lines: 10000
              output_table:
                location: bottom
                columns: []
left_panel: null
right_panel: null
bottom_panel: null
scene: {}
poster: null
prompt_windows: []
mcap_path: null
conditionals: []
